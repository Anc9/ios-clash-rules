# ProjectClash iOS Bilibili response rewrite module
# Scope: Bilibili splash response cleanup only.
name: 哔哩哔哩 App Rewrite
desc: 清理哔哩哔哩开屏响应字段和开屏 CDN 响应
author: Anc9
category: AdBlock
version: 1.0.0
date: '2026-11-15'

rules:
- DOMAIN,cm.bilibili.com,REJECT

http:
  mitm:
  - app.bilibili.com
  - upos-sz-static.bilivideo.com
  - api.live.bilibili.com
  - api.vc.bilibili.com
  rewrite:
    - ^https?://upos-sz-static\.bilivideo\.com/ssaxcode/\w{2}/\w{2}/\w{32}-1-SPLASH(?:\?.*)?$ - reject-dict
  body-rewrite:
    - ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?.*)?$ response-jq .data |= if type == "object" then with_entries(if .key | IN("show", "event_list") then .value = [] else . end) else . end
    - ^https?://api\.live\.bilibili\.com/xlive/app-room/v1/index/getInfoByRoom(?:\?.*)?$ response-jq .data.activity_banner_info = null
    - ^https?://api\.vc\.bilibili\.com/dynamic_svr/v1/dynamic_svr/dynamic_(?:history|new)(?:\?.*)?$ response-jq .data.cards |= map(select(((.card // "") | contains("ad_ctx")) | not))
