# ProjectClash iOS Goofish response rewrite module
# Scope: Goofish splash response cleanup only.
name: 闲鱼 App Rewrite
desc: 拒绝闲鱼开屏广告 JSON 响应
author: Anc9
category: AdBlock
version: 1.0.0
date: '2026-11-15'

http:
  mitm:
  - acs.m.goofish.com
  - g-acs.m.goofish.com
  rewrite:
  body-rewrite:
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads(?:/|\?|$) - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.item\.search\.activate/2\.0 - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.discover/1\.0 - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate/1\.0 - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh/1\.0 - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.buy\.feeds(?:/|\?|$) - reject-dict
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.playboy\.recommend/1\.0 - reject
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.shade(?:/|\?|$) response-jq del(.data)
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.user\.strategy\.list(?:/|\?|$) response-jq del(.data)
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.group\.myself\.banner(?:/|\?|$) response-jq .data.bannerList = []
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.playboy\.recommend/2\.0 response-jq .data.recommends = [] | .data.items = [] | .data.next = false
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.recommend\.list(?:/|\?|$) response-jq .data.cardList = []
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.fun\.follow\.often\.visit(?:/|\?|$) response-jq .data.sections = []
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.circle\.myself\.banner/1\.0 response-jq .data.bannerList = []
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.circle\.visited/1\.0 response-jq .data.visitedCircleList = []
