# ProjectClash iOS domestic app ad blocking Lite module
# Scope: high-confidence advertising endpoints and precise response rewrites only.
name: iOS 国内 App 去广告 Lite
desc: 高确定性广告域名与精确开屏响应处理；不加载远程广告规则集，不包含 VIP 解锁或远程脚本
author: Anc9
category: AdBlock
version: 1.0.0
date: '2026-11-15'

rules:
- DOMAIN,df.tanx.com,REJECT
- DOMAIN,bdlog.tanx.com,REJECT
- DOMAIN,ipm.atm.youku.com,REJECT
- DOMAIN,mi.gdt.qq.com,REJECT
- DOMAIN,ii.gdt.qq.com,REJECT
- DOMAIN,sdk.e.qq.com,REJECT
- DOMAIN,sdkconfig.e.qq.com,REJECT
- DOMAIN,adsmind.gdtimg.com,REJECT
- DOMAIN,splashqqlive.gtimg.com,REJECT
- DOMAIN,ads-union.jd.com,REJECT
- DOMAIN,jzt.jd.com,REJECT
- DOMAIN,c-nfa.jd.com,REJECT
- DOMAIN,bdsp.x.jd.com,REJECT
- DOMAIN,optimus-ads.amap.com,REJECT
- DOMAIN,amap-aos-info-nogw.amap.com,REJECT
- DOMAIN,wmapi.meituan.com,REJECT
- DOMAIN,m.client.10010.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT

http:
  mitm:
  - acs.m.goofish.com
  - g-acs.m.goofish.com
  - acs.m.taobao.com
  - r.inews.qq.com
  - app.bilibili.com
  - upos-sz-static.bilivideo.com
  rewrite:
  body-rewrite:
  - ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?.*)?$ response-jq .data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)
  - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads(?:/|\?|$) - reject-dict
  - ^https?://acs\.m\.taobao\.com/gw/mtop\.taobao\.(?:idlecommerce\.splash\.ads|idle\.home\.welcome)(?:/|\?|$) - reject-dict
  - ^https?://r\.inews\.qq\.com/(?:getSplash|getFullScreenPic)(?:/|\?|$) - reject-dict
  - ^https?://upos-sz-static\.bilivideo\.com/ssaxcode/\w{2}/\w{2}/\w{32}-1-SPLASH(?:\?.*)?$ - reject-dict
