# ProjectClash iOS all-in-one adblock and app rewrite module
# Scope: combined personal module; use individual AppRewrite modules for isolated testing.
name: iOS 去广告与 App Rewrite 全量模块
desc: 合并域名广告拦截、开屏域名和各 App 响应改写；与独立模块二选一
author: Anc9
category: AdBlock
version: 1.0.12
date: '2026-11-18'

rule-providers:
  domestic-ads:
    type: http
    behavior: domain
    format: mrs
    path: ./ruleset/domestic-ads.mrs
    url: https://github.com/DustinWin/ruleset_geodata/releases/download/mihomo-ruleset/ads.mrs
    interval: 86400

rules:
- RULE-SET,domestic-ads,REJECT
- DOMAIN,ipm.atm.youku.com,REJECT
- DOMAIN,splashqqlive.gtimg.com,REJECT
- DOMAIN,poplayer.template.alibaba.com,REJECT
- DOMAIN,df.tanx.com,REJECT
- DOMAIN,bdlog.tanx.com,REJECT
- DOMAIN,ssp-track.adn-plus.com.cn,REJECT
- DOMAIN,adx-track.adn-plus.com.cn,REJECT
- DOMAIN,statics.adanxing.com,REJECT
- DOMAIN,aaid.uyunad.com,REJECT
- DOMAIN,mi.gdt.qq.com,REJECT
- DOMAIN,ii.gdt.qq.com,REJECT
- DOMAIN,sdk.e.qq.com,REJECT
- DOMAIN,sdkconfig.e.qq.com,REJECT
- DOMAIN,adsmind.gdtimg.com,REJECT
- DOMAIN,ads-union.jd.com,REJECT
- DOMAIN,jzt.jd.com,REJECT
- DOMAIN,c-nfa.jd.com,REJECT
- DOMAIN,bdsp.x.jd.com,REJECT
- DOMAIN,optimus-ads.amap.com,REJECT
- DOMAIN,amap-aos-info-nogw.amap.com,REJECT
- DOMAIN,wmapi.meituan.com,REJECT
- DOMAIN,m.client.10010.com,REJECT
- DOMAIN,api.ys7.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
- DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT
- DOMAIN,data.bilibili.com,REJECT
- DOMAIN,log.bilibili.com,REJECT
- DOMAIN,cm.bilibili.com,REJECT
- DOMAIN-SUFFIX,biz.weibo.com,REJECT
- DOMAIN-SUFFIX,fastimage.uve.weibo.com,REJECT
- DOMAIN-SUFFIX,adimg.vue.weibo.com,REJECT
- DOMAIN-SUFFIX,zymo.mps.weibo.com,REJECT
- DOMAIN-SUFFIX,weibomingzi.com,REJECT
- DOMAIN-SUFFIX,promote.biz.weibo.cn,REJECT
- DOMAIN-SUFFIX,gw5.push.mcp.weibo.cn,REJECT
- DOMAIN-SUFFIX,gw6.push.mcp.weibo.cn,REJECT
- DOMAIN-SUFFIX,game.weibo.cn,REJECT
- DOMAIN-SUFFIX,adimg.uve.weibo.com,REJECT
- DOMAIN-SUFFIX,game.weibo.com,REJECT
- DOMAIN-SUFFIX,alitui.weibo.com,REJECT
- DOMAIN-SUFFIX,dp.im.weibo.cn,REJECT
- DOMAIN-SUFFIX,click.uve.weibo.com,REJECT
- DOMAIN-SUFFIX,wax.weibo.com,REJECT
- DOMAIN-SUFFIX,widget.weibo.com,REJECT
- DOMAIN-SUFFIX,dsp.edm.weibo.cn,REJECT
- DOMAIN-SUFFIX,tui.weibo.com,REJECT
- DOMAIN-SUFFIX,ad.weibo.com,REJECT
- DOMAIN,datacollection.uve.weibo.com,REJECT
- DOMAIN,referee.xiaohongshu.com,REJECT
- DOMAIN,adpinpai.video.weibocdn.com,REJECT



http:
  mitm:
  - app.bilibili.com
  - upos-sz-static.bilivideo.com
  - api.live.bilibili.com
  - api.vc.bilibili.com
  - acs.m.goofish.com
  - g-acs.m.goofish.com
  - acs.m.taobao.com
  - r.inews.qq.com
  - api.m.jd.com
  - api.weibo.cn
  - api.weibo.com
  - mapi.weibo.com
  - weibointl.api.weibo.cn
  - bootrealtime.uve.weibo.com
  - bootpreload.uve.weibo.com
  - sdkapp.uve.weibo.com
  - wbapp.uve.weibo.com
  - card.weibo.com
  - weibo.com
  - m.ctrip.com
  - home.mi.com
  - dimg04.c-ctrip.com
  - api.zhihu.com
  - edith.xiaohongshu.com
  - rec.xiaohongshu.com
  - www.xiaohongshu.com
  - referee.xiaohongshu.com
  - app-api.smzdm.com
  rewrite:
    - ^https?://upos-sz-static\.bilivideo\.com/ssaxcode/\w{2}/\w{2}/\w{32}-1-SPLASH(?:\?.*)?$ - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads(?:/|\?|$) - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.item\.search\.activate/2\.0 - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.discover/1\.0 - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate/1\.0 - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh/1\.0 - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.buy\.feeds(?:/|\?|$) - reject-dict
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.playboy\.recommend/1\.0 - reject
    - ^https?://acs\.m\.taobao\.com/gw/mtop\.taobao\.(?:idlecommerce\.splash\.ads|idle\.home\.welcome)(?:/|\?|$) - reject-dict
    - ^https?://acs\.m\.taobao\.com/gw/mtop\.alibaba\.advertisementservice\.getadv(?:/|\?|$) - reject-dict
    - ^https?://r\.inews\.qq\.com/(?:getSplash|getFullScreenPic)(?:/|\?|$) - reject-dict
    - ^https?://m\.ctrip\.com/restapi/soa2/\d+/json/getAdsList(?:\?.*)?$ - reject-dict
    - ^https?://home\.mi\.com/cgi-op/api/v1/recommendation/openingBanner(?:/|\?|$) - reject-dict
    - ^https?://home\.mi\.com/cgi-op/api/v1/resource/realtime/openingBanner(?:/|\?|$) - reject-dict
    - ^https?://m\.ctrip\.com/restapi/(?:.+/)?(?:sc)?json/tripAds(?:\?.*)?$ - reject-dict
    - ^https?://dimg04\.c-ctrip\.com/images/[A-Za-z0-9]{21}\.(?:jpg|png)(?:\?.*)?$ - reject-img
    - ^https?://api\.zhihu\.com/commercial_api/(?:launch_v2|real_time_launch_v2)(?:\?.*)?$ - reject-dict
    - ^https?://api\.zhihu\.com/(?:launch|real_time)(?:\?.*)?$ - reject-dict
    - ^https?://www\.xiaohongshu\.com/api/sns/v\d+/(?:tag/ads_engage|ads/(?:apple/record|resource))(?:\?.*)?$ - reject-dict
    - ^https?://referee\.xiaohongshu\.com/v\d+/stateReport(?:\?.*)?$ - reject-dict
    - ^https?://bootrealtime\.uve\.weibo\.com/v\d+/ad/realtime(?:\?.*)?$ - reject-dict
    - ^https?://bootpreload\.uve\.weibo\.com/v\d+/ad/preload(?:\?.*)?$ - reject-dict
    - ^https?://(?:sdk|wb)app\.uve\.weibo\.com/(?:interface/sdk/sdkad\.php|wbapplua/wbpullad\.lua)(?:\?.*)?$ - reject-dict
    - ^https?://sdkapp\.uve\.weibo\.com/interface/sdk/(?:get-lbs-cell-info\.php|sdkconfig\.php)(?:\?.*)?$ - reject-dict
    - ^https?://(?:m)?api\.weibo\.c(?:n|om)/2/logservice/service\?(?:.*)$ - reject
    - ^https?://(?:m)?api\.weibo\.c(?:n|om)/2/push/info\?(?:.*)$ - reject-dict
    - ^https?://(?:m)?api\.weibo\.c(?:n|om)/2/push/daily(?:\?.*)?$ - reject-dict
    - ^https?://(?:m)?api\.weibo\.c(?:n|om)/2/!/(?:huati/discovery_home_bottom_channels|chaohua/discovery/home_bottom/switch|was/finder/searchbarchange)(?:\?.*)?$ - reject-dict
    - ^https?://card\.weibo\.com/article/m/aj/(?:reward|uvead)\?(?:.*)$ - reject-dict
    - ^https?://weibo\.com/ttarticle/x/m/aj/(?:reward|uvead)\?(?:.*)$ - reject-dict
    - ^https?://app-api\.smzdm\.com/util/loading(?:/|\?|$) - reject-dict
  body-rewrite:
    - ^https?://app\.bilibili\.com/x/v2/splash/(?:list|show|event/list2)(?:\?.*)?$ response-jq .data.max_time = 0 | .data.min_interval = 31536000 | .data.pull_interval = 31536000 | .data.show = [] | .data.event_list = [] | .data.list |= if type == "array" then map(if type == "object" then .duration = 0 | .begin_time = 1915027200 | .end_time = 1924272000 else . end) elif type == "object" then .show = [] else . end
    - ^https?://api\.live\.bilibili\.com/xlive/app-room/v1/index/getInfoByRoom(?:\?.*)?$ response-jq .data.activity_banner_info = null
    - ^https?://api\.vc\.bilibili\.com/dynamic_svr/v1/dynamic_svr/dynamic_(?:history|new)(?:\?.*)?$ response-jq .data.cards |= map(select(((.card // "") | contains("ad_ctx")) | not))
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.shade(?:/|\?|$) response-jq del(.data)
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.user\.strategy\.list(?:/|\?|$) response-jq del(.data)
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.group\.myself\.banner(?:/|\?|$) response-jq .data.bannerList = []
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.playboy\.recommend/2\.0 response-jq .data.recommends = [] | .data.items = [] | .data.next = false
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.recommend\.list(?:/|\?|$) response-jq .data.cardList = []
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.fun\.follow\.often\.visit(?:/|\?|$) response-jq .data.sections = []
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.circle\.myself\.banner/1\.0 response-jq .data.bannerList = []
    - ^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.circle\.visited/1\.0 response-jq .data.visitedCircleList = []
    - ^https?://api\.m\.jd\.com/client\.action\?functionId=start(?:&.*)?$ response-jq . |= if (.images | type) == "array" then (.images |= map(if type == "array" then map(if type == "object" then if has("showTimes") then .showTimes = 0 | .onlineTime = "2030-12-24 00:00:00" | .referralsTime = "2030-12-25 00:00:00" | .time = 0 else . end else . end) else . end) | .countdown = 100 | .showTimesDaily = 0) else . end
    - ^https?://(?:api\.weibo\.cn|api\.weibo\.com|mapi\.weibo\.com)/2/cardlist\?(?:.*&)?containerid=231159(?:&.*)?$ response-jq .cards |= if type == "array" then map(if (.itemid // "") == "hotword" or (.card_type // 0) == 17 or (.card_type // 0) == 101 then . elif ((.card_group // null) | type) == "array" then .card_group |= map(select((.itemid // "") == "hotword" or (.card_type // 0) == 17 or (.card_type // 0) == 101)) | select((.card_group | length) > 0) else empty end) else . end | .items |= if type == "array" then map(select(.itemId == "hotword" or .itemid == "hotword" or (.type == "text" and ((.text.content // "") | contains("实时热点"))))) else . end
    - ^https?://weibointl\.api\.weibo\.cn/portal\.php\?a=trends&(?:.*)$ response-jq .data.order = ["search_topic"] | del(.data.banner)
    - ^https?://(?:api\.weibo\.cn|api\.weibo\.com|mapi\.weibo\.com)/2/(?:groups/timeline|statuses/(?:unread|unread_hot_timeline|unread_friends_timeline|friends/timeline|friends_timeline|container_timeline(?:_hot|_unread)?))(?:\?.*)?$ response-jq .statuses |= if type == "array" then map(select((.mblogtype // 0) != 1 and ((.mblogtypename // "") != "广告") and ((.mblogtypename // "") != "热推") and (((.promotion // {}).type // "") != "ad") and (((.page_info // {}).actionlog.source // "") != "ad") and (((.content_auth_info // {}).content_auth_title // "") != "广告"))) else . end | .advertises = [] | .ad = [] | .trends = []
    - ^https?://(?:api\.weibo\.cn|api\.weibo\.com|mapi\.weibo\.com)/2/flowpage(?:\?.*)?$ response-jq .items |= if type == "array" then map(select(.itemId == "hotword" or (.type == "text" and ((.text.content // "") | contains("实时热点"))))) else . end | del(.channelInfo)
    - ^https?://(?:edith|rec|www)\.xiaohongshu\.com/api/sns/v6/homefeed(?:\?.*)?$ response-jq .data |= if type == "array" then map(select((.is_ads // false) != true and (.ads_info == null) and (.card_icon == null) and (((.note_attributes // []) | index("goods")) == null))) else . end
    - ^https?://edith\.xiaohongshu\.com/api/sns/v[1-5]/homefeed\?(?:.*)$ response-jq .data |= if type == "object" then with_entries(select((.value.is_ads // false) != true and (.value.ads_info == null) and (.value.card_icon == null))) elif type == "array" then map(select((.is_ads // false) != true and (.ads_info == null) and (.card_icon == null))) else . end
    - ^https?://(?:edith|rec|www)\.xiaohongshu\.com/api/sns/v\d+/followfeed(?:\?.*)?$ response-jq .data.items |= if type == "array" then map(select((.is_ads // false) != true and (.ads_info == null) and (.card_icon == null))) else . end
